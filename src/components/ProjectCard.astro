---
import TerminalTyping from './previews/TerminalTyping.jsx';
import BrowserScreenshot from './previews/BrowserScreenshot.jsx';
import ApiMockPanel from './previews/ApiMockPanel.jsx';
import MetricsDashboard from './previews/MetricsDashboard.jsx';

interface Props {
  title: string;
  categoryEmoji: string;
  description: string;
  techStack: string[];
  githubUrl: string;
  demoUrl?: string;
  screenshot?: string;
  year: number;
  featured?: boolean;
  slug: string;
  previewData?: any;
  lang?: string;
}

const {
  title,
  categoryEmoji,
  description,
  techStack,
  githubUrl,
  demoUrl,
  screenshot,
  year,
  featured = false,
  slug,
  previewData,
  lang = 'pl',
} = Astro.props;

const href = lang === 'en' ? `/en/projects/${slug}` : `/projects/${slug}`;
---

<article class:list={['project-card', 'terminal-border', { 'project-card--featured': featured }]}>
  {/* Stretched link — covers the entire card */}
  <a href={href} class="project-card__stretched-link" aria-label={title}></a>

  {featured && (
    <span class="project-card__badge" aria-label="Featured">★</span>
  )}

  <header class="project-card__header">
    <span class="project-card__emoji">{categoryEmoji}</span>
    <h3 class="project-card__title terminal-text">{title}</h3>
  </header>

  <p class="project-card__desc">{description}</p>

  {/* Type-specific preview based on category */}
  <div class="project-card__preview">
    {previewData?.type === 'terminal' ? (
      <TerminalTyping commands={previewData.commands} lang={lang} client:visible />
    ) : previewData?.type === 'browser' ? (
      <BrowserScreenshot screenshots={previewData.screenshots} liveUrl={previewData.liveUrl} title={title} client:visible />
    ) : previewData?.type === 'api' ? (
      <ApiMockPanel endpoints={previewData.endpoints} lang={lang} client:visible />
    ) : previewData?.type === 'metrics' ? (
      <MetricsDashboard epochs={previewData.epochs} accuracyData={previewData.accuracyData} lossData={previewData.lossData} finalAccuracy={previewData.finalAccuracy} samplePredictions={previewData.samplePredictions} client:visible />
    ) : screenshot ? (
      <div class="project-card__media">
        <img
          src={screenshot}
          alt={`${title} screenshot`}
          class="project-card__screenshot"
          loading="lazy"
        />
      </div>
    ) : (
      <div class="project-card__media project-card__media--placeholder" aria-hidden="true">
        <svg class="project-card__placeholder-icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="4 17 10 11 4 5"></polyline>
          <line x1="12" y1="19" x2="20" y2="19"></line>
        </svg>
      </div>
    )}
  </div>

  <ul class="project-card__stack" role="list">
    {techStack.map((tech) => (
      <li class="project-card__tag">
        <code>{tech}</code>
      </li>
    ))}
  </ul>

  <footer class="project-card__footer">
    <div class="project-card__links">
      <a
        href={githubUrl}
        class="project-card__link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${title} source code on GitHub`}
      >
        <svg class="project-card__icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span>GitHub</span>
      </a>
      {demoUrl && (
        <a
          href={demoUrl}
          class="project-card__link project-card__link--demo"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${title} live demo`}
        >
          <svg class="project-card__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span>Demo</span>
        </a>
      )}
    </div>
    <span class="project-card__year">{year}</span>
  </footer>
</article>

<style>
  .project-card {
    position: relative;
    background: var(--color-bg-card);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    max-width: 36rem;
  }

  /* Stretched link — makes entire card clickable */
  .project-card__stretched-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    text-decoration: none;
    color: inherit;
  }

  .project-card__stretched-link:focus-visible {
    outline: 2px solid var(--color-terminal-green);
    outline-offset: 2px;
    border-radius: inherit;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow-strong);
    border-color: var(--color-terminal-green);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover {
      transform: none;
    }
  }

  /* Featured badge */
  .project-card__badge {
    position: absolute;
    top: calc(var(--space-2) * -1);
    right: var(--space-3);
    background: var(--color-terminal-green);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    line-height: 1;
    z-index: 2;
  }

  /* Header: emoji + title */
  .project-card__header {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .project-card__emoji {
    font-size: var(--text-lg);
    line-height: 1;
    flex-shrink: 0;
  }

  .project-card__title {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-tight);
    word-break: break-word;
  }

  /* Description */
  .project-card__desc {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: 0;
  }

/* Preview wrapper — 16:9 aspect ratio container for all preview types */
.project-card__preview {
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  max-height: 280px;
}

@media (min-width: 768px) {
  .project-card__preview {
    max-height: 320px;
  }
}

  /* Media / screenshot fallback */
  .project-card__media {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .project-card__screenshot {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__media--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent-dim);
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 10px,
        rgba(74, 246, 38, 0.03) 10px,
        rgba(74, 246, 38, 0.03) 11px
      );
  }

  .project-card__placeholder-icon {
    opacity: 0.4;
  }

  /* Tech stack */
  .project-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .project-card__tag {
    display: inline;
  }

  .project-card__tag code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: calc(var(--space-1) * 0.5) var(--space-2);
    border: 1px solid var(--color-accent-dim);
    border-radius: 999px;
    color: var(--color-terminal-green);
    background: rgba(74, 246, 38, 0.06);
    white-space: nowrap;
    line-height: var(--leading-normal);
  }

  /* Footer: links + year — sits above stretched link */
  .project-card__footer {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .project-card__links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .project-card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    padding: var(--space-1) var(--space-2);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .project-card__link:hover {
    color: var(--color-terminal-green);
    border-color: var(--color-terminal-green);
  }

  .project-card__icon {
    flex-shrink: 0;
  }

  .project-card__year {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
