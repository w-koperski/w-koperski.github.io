---
interface Props {
  title: string;
  categoryEmoji: string;
  description: string;
  techStack: string[];
  githubUrl: string;
  demoUrl?: string;
  screenshot?: string;
  year: number;
  featured?: boolean;
  slug: string;
  previewData?: any;
  lang?: string;
}

const {
  title,
  categoryEmoji,
  description,
  techStack,
  githubUrl,
  demoUrl,
  slug,
  lang = 'pl',
} = Astro.props;

const href = lang === 'en' ? `/en/projects/${slug}` : `/projects/${slug}`;
---

<div class="bg-surface-elevated border border-outline-variant rounded-lg overflow-hidden flex flex-col group hover:shadow-[0_0_20px_rgba(16,185,129,0.05)] transition-all duration-300 relative">
  <!-- Terminal Header -->
  <div class="bg-terminal-header px-4 py-2 flex items-center gap-2 border-b border-outline-variant/30">
    <div class="w-3 h-3 rounded-full bg-error/70"></div>
    <div class="w-3 h-3 rounded-full bg-tertiary/70"></div>
    <div class="w-3 h-3 rounded-full bg-primary/70"></div>
    <span class="ml-2 font-code-sm text-code-sm text-on-surface-variant line-clamp-1">{slug}.exe</span>
  </div>

  <div class="p-6 flex-grow flex flex-col justify-between relative z-10">
    <div>
      <h3 class="font-headline-md text-headline-md text-on-surface mb-2">{title}</h3>
      <p class="font-body-md text-body-md text-on-surface-variant mb-4 line-clamp-3">{description}</p>
    </div>

    <div class="mt-4 border-t border-outline-variant/20 pt-4">
      <div class="flex flex-wrap gap-2 mb-4">
        {techStack.slice(0, 3).map((tech) => (
          <span class="font-label-caps text-label-caps border border-outline px-2 py-1 rounded text-on-surface-variant">
            {tech}
          </span>
        ))}
      </div>

      <div class="flex items-center justify-between">
        <a href={href} class="text-primary hover:text-primary-fixed flex items-center gap-1 font-label-caps text-label-caps z-20 relative">
          <span class="material-symbols-outlined text-sm">open_in_new</span> Details
        </a>
      </div>
    </div>
  </div>

  <a href={href} class="absolute inset-0 z-10" aria-label={title}></a>
</div>
