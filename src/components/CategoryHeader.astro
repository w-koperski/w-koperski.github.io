---
interface Props {
  emoji: string;
  name: string;
  count: number;
}

const { emoji, name, count } = Astro.props;
---

<section class="w-full">
  <div class="flex items-center gap-4 mb-8 border-b border-outline-variant/30 pb-4">
    <span class="material-symbols-outlined text-primary text-3xl">folder_special</span>
    <h2 class="font-headline-md text-headline-md text-on-surface">{name}</h2>
    <span class="text-on-surface-variant text-sm font-code-sm ml-auto">{count} {count === 1 ? 'Project' : 'Projects'}</span>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <slot />
  </div>
</section>
