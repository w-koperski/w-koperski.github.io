---
import { t, useTranslatedPath } from '../i18n/utils';

interface Props {
  lang: 'pl' | 'en';
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const translatePath = useTranslatedPath(lang);

const navLinks = [
  { key: 'nav.home' as const, href: '/' },
  { key: 'nav.about' as const, href: '/about' },
  { key: 'nav.projects' as const, href: '/projects' },
  { key: 'nav.skills' as const, href: '/skills' },
  { key: 'nav.contact' as const, href: '/contact' },
];

function isActive(linkHref: string): boolean {
  const resolved = translatePath(linkHref);
  if (resolved === '/' || resolved === '/en' || resolved === '/en/') {
    return currentPath === resolved || currentPath === resolved + '/';
  }
  return currentPath === resolved || currentPath.startsWith(resolved + '/');
}

const langSwitchLabel = t('lang.switch', lang); // using icon
const langSwitchHref = lang === 'pl' ? `/en${currentPath}` : currentPath.replace(/^\/en/, '') || '/';
---

<header class="bg-surface/80 backdrop-blur-md full-width top-0 z-50 border-b border-outline-variant/30 shadow-sm shadow-glow-emerald/5 sticky">
  <div class="flex justify-between items-center w-full px-gutter max-w-container-max mx-auto h-16">
    <a href={translatePath('/')} class="font-label-caps text-headline-md font-bold text-primary tracking-tighter hover:text-primary-fixed transition-colors">
      SYSTEM_CORE
    </a>

    <nav class="hidden md:flex gap-8 items-center">
      {navLinks.map(({ key, href }) => (
        <a
          href={translatePath(href)}
          class:list={[
            "font-label-caps text-label-caps transition-colors duration-200 hover:bg-surface-container-high/50 hover:text-primary px-2 py-1 rounded",
            isActive(href) ? "text-primary border-b-2 border-primary pb-1" : "text-on-surface-variant"
          ]}
        >
          {t(key, lang)}
        </a>
      ))}
      <a href={langSwitchHref} class="text-on-surface-variant hover:text-primary hover:bg-surface-container-high/50 p-2 rounded flex items-center justify-center ml-4" title={lang === 'pl' ? 'Switch to English' : 'Zmień na polski'}>
        <span class="material-symbols-outlined">language</span>
        <span class="ml-1 text-xs">{lang.toUpperCase()}</span>
      </a>
    </nav>

    <!-- Mobile Hamburger -->
    <button
      class="md:hidden text-on-surface-variant hover:text-primary p-2"
      aria-label="Toggle menu"
      aria-expanded="false"
      id="nav-hamburger"
    >
      <span class="material-symbols-outlined pointer-events-none">menu</span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div class="hidden bg-surface-container-highest border-t border-outline-variant/30 px-gutter py-4" id="nav-mobile-menu" aria-hidden="true">
    <nav class="flex flex-col gap-4">
      {navLinks.map(({ key, href }) => (
        <a
          href={translatePath(href)}
          class:list={[
            "font-label-caps text-label-caps p-2 rounded transition-colors",
            isActive(href) ? "text-primary bg-surface-container-low border-l-2 border-primary" : "text-on-surface-variant hover:bg-surface-container-low hover:text-primary"
          ]}
        >
          {t(key, lang)}
        </a>
      ))}
      <a href={langSwitchHref} class="flex items-center text-on-surface-variant hover:text-primary hover:bg-surface-container-low p-2 rounded mt-2">
         <span class="material-symbols-outlined mr-2">language</span>
         <span class="font-label-caps text-label-caps">{lang === 'pl' ? 'English' : 'Polski'}</span>
      </a>
    </nav>
  </div>
</header>

<script is:inline>
(function() {
  document.addEventListener('click', (e) => {
    const hamburger = e.target.closest('#nav-hamburger');
    const mobileMenu = document.getElementById('nav-mobile-menu');
    if (!hamburger || !mobileMenu) return;

    const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
    hamburger.setAttribute('aria-expanded', String(!isOpen));
    if (isOpen) {
        mobileMenu.classList.add('hidden');
        hamburger.innerHTML = '<span class="material-symbols-outlined pointer-events-none">menu</span>';
    } else {
        mobileMenu.classList.remove('hidden');
        hamburger.innerHTML = '<span class="material-symbols-outlined pointer-events-none">close</span>';
    }
  }, { passive: false });

  // Close when clicking outside
  document.addEventListener('click', (e) => {
    const hamburger = document.getElementById('nav-hamburger');
    if (!hamburger || hamburger.getAttribute('aria-expanded') !== 'true') return;
    if (e.target.closest('header')) return;

    const mobileMenu = document.getElementById('nav-mobile-menu');
    hamburger.setAttribute('aria-expanded', 'false');
    if (mobileMenu) mobileMenu.classList.add('hidden');
    hamburger.innerHTML = '<span class="material-symbols-outlined pointer-events-none">menu</span>';
  });

  document.addEventListener('astro:page-load', () => {
    const mobileMenu = document.getElementById('nav-mobile-menu');
    const hamburger = document.getElementById('nav-hamburger');
    if (mobileMenu) mobileMenu.classList.add('hidden');
    if (hamburger) {
      hamburger.setAttribute('aria-expanded', 'false');
      hamburger.innerHTML = '<span class="material-symbols-outlined pointer-events-none">menu</span>';
    }
  });
})();
</script>
