---
interface Props {
  snippets?: Array<{ title: string; language: string; code: string }>;
  lang: string;
}

const { snippets, lang } = Astro.props;

if (!snippets || snippets.length === 0) return;

const sectionTitle = lang === 'en' ? 'Code Examples' : 'Przykłady kodu';
---

<section class="detail-snippets">
  <h2 class="detail-section__title terminal-text">{sectionTitle}</h2>
  <div class="detail-snippets__list">
    {snippets.map((snippet) => (
      <div class="detail-snippet">
        <h3 class="detail-snippet__title">
          <span class="detail-snippet__lang">{snippet.language}</span>
          {snippet.title}
        </h3>
        <pre class="detail-snippet__code terminal-border"><code>{snippet.code}</code></pre>
      </div>
    ))}
  </div>
</section>

<style>
  .detail-snippets {
    margin-bottom: var(--space-12);
  }

  .detail-section__title {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .detail-snippets__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .detail-snippet__title {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 400;
  }

  .detail-snippet__lang {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-terminal-green);
    background: rgba(74, 246, 38, 0.1);
    border: 1px solid rgba(74, 246, 38, 0.2);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .detail-snippet__code {
    background-color: rgba(0, 0, 0, 0.6);
    color: var(--color-terminal-green);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: var(--space-6);
    border-radius: var(--radius-md);
    overflow-x: auto;
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .detail-snippet__code code {
    font-family: inherit;
    font-size: inherit;
    color: inherit;
  }
</style>
