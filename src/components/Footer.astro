---
import { t } from '../i18n/utils';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;
---

<footer class="bg-surface-container-lowest full-width mt-section-gap border-t border-outline-variant/20 py-12 px-gutter">
  <div class="flex flex-col md:flex-row justify-between items-center w-full max-w-container-max mx-auto gap-8">
    <div class="font-label-caps text-body-lg text-primary text-center md:text-left">
      SYSTEM STATUS: OPTIMAL // &copy; {new Date().getFullYear()} {t('footer.rights', lang)}
    </div>

    <nav class="flex flex-wrap justify-center gap-6">
      <a
        href="https://github.com/w-koperski"
        target="_blank"
        rel="noopener noreferrer"
        class="font-label-caps text-label-caps text-on-tertiary-container/60 hover:text-primary transition-opacity hover:opacity-80 cursor-pointer"
      >
        GitHub
      </a>
      <a
        href="#"
        class="font-label-caps text-label-caps text-on-tertiary-container/60 hover:text-primary transition-opacity hover:opacity-80 cursor-pointer"
      >
        LinkedIn
      </a>
      <a
        href="#"
        class="font-label-caps text-label-caps text-on-tertiary-container/60 hover:text-primary transition-opacity hover:opacity-80 cursor-pointer"
      >
        Terminal
      </a>
    </nav>
  </div>
</footer>
