---
import { t } from '../i18n/utils';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;
---

<footer class="footer">
  <div class="footer__separator" aria-hidden="true">
    ----------------------------------------------------------------------------------------------------
  </div>
  <div class="footer__inner">
    <p class="footer__rights terminal-text">{t('footer.rights', lang)}</p>
    <div class="footer__links">
      <a
        href="https://github.com/w-koperski"
        target="_blank"
        rel="noopener noreferrer"
        class="footer__link"
      >
        GitHub
      </a>
      <span class="footer__divider" aria-hidden="true">|</span>
      <span class="footer__built terminal-text">{t('footer.built', lang)}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-8) var(--space-6) var(--space-6);
    max-width: 72rem;
    margin: 0 auto;
  }

  .footer__separator {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent-dim);
    overflow: hidden;
    white-space: nowrap;
    user-select: none;
    margin-bottom: var(--space-4);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer__rights {
    font-size: var(--text-sm);
  }

  .footer__links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .footer__link {
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .footer__link:hover {
    color: var(--color-terminal-green);
  }

  .footer__divider {
    color: var(--color-border);
  }

  .footer__built {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 480px) {
    .footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
