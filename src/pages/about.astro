---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/utils';

const lang = 'pl';
const pageTitle = t('about.title', lang);
---

<Base title={pageTitle} lang={lang} description="O mnie — Wojciech Koperski, developer pasjonujący się tworzeniem oprogramowania.">
  <section class="neofetch">
    <div class="neofetch__card terminal-border terminal-glow-element">
      <div class="neofetch__layout">
        <pre class="neofetch__ascii terminal-text terminal-glow" aria-hidden="true">  ██  ██
 ██  ██
██  ██
██  ██
 ██  ██
  ██  ██</pre>

        <div class="neofetch__info">
          <p class="neofetch__user terminal-text terminal-glow">wk@portfolio</p>
          <p class="neofetch__separator">───────────────────</p>
          <dl class="neofetch__fields">
            <div class="neofetch__row">
              <dt class="neofetch__key terminal-text">OS:</dt>
              <dd class="neofetch__value">Developer</dd>
            </div>
            <div class="neofetch__row">
              <dt class="neofetch__key terminal-text">Shell:</dt>
              <dd class="neofetch__value">TypeScript/Rust/Python</dd>
            </div>
            <div class="neofetch__row">
              <dt class="neofetch__key terminal-text">WM:</dt>
              <dd class="neofetch__value">Vue 3 / React</dd>
            </div>
            <div class="neofetch__row">
              <dt class="neofetch__key terminal-text">Terminal:</dt>
              <dd class="neofetch__value">ncurses / CLI</dd>
            </div>
            <div class="neofetch__row">
              <dt class="neofetch__key terminal-text">Editor:</dt>
              <dd class="neofetch__value">VS Code + Neovim</dd>
            </div>
            <div class="neofetch__row">
              <dt class="neofetch__key terminal-text">Uptime:</dt>
              <dd class="neofetch__value">3+ lata kodowania</dd>
            </div>
            <div class="neofetch__row">
              <dt class="neofetch__key terminal-text">Packages:</dt>
              <dd class="neofetch__value">28 projektów</dd>
            </div>
            <div class="neofetch__row">
              <dt class="neofetch__key terminal-text">CPU:</dt>
              <dd class="neofetch__value">C++, Rust, Python, JS, C#</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="neofetch__palette" aria-label="Kolor palety">
        <span class="neofetch__color" style="background: #4AF626;"></span>
        <span class="neofetch__color" style="background: #2A8D15;"></span>
        <span class="neofetch__color" style="background: #E5E7EB;"></span>
        <span class="neofetch__color" style="background: #9CA3AF;"></span>
        <span class="neofetch__color" style="background: #F59E0B;"></span>
        <span class="neofetch__color" style="background: #EF4444;"></span>
        <span class="neofetch__color" style="background: #111111;"></span>
        <span class="neofetch__color" style="background: #0A0A0A;"></span>
      </div>
    </div>

    <p class="neofetch__bio">
      Cześć, jestem <span class="terminal-text">Wojciech</span> — developer, który koduje od ponad trzech lat.
      Tworzę wszystko od narzędzi CLI, przez aplikacje webowe, aż po modele ML.
      Uwielbiam terminal, czyste architektury i pić kawę podczas debugowania Rusta o 2 w nocy.
    </p>
  </section>
</Base>

<style>
  .neofetch {
    max-width: 48rem;
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-12);
  }

  .neofetch__card {
    background: var(--color-bg-card);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    position: relative;
    overflow: hidden;
  }

  .neofetch__layout {
    display: flex;
    gap: var(--space-8);
    align-items: flex-start;
  }

  .neofetch__ascii {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    flex-shrink: 0;
    user-select: none;
    letter-spacing: 0.05em;
  }

  .neofetch__info {
    flex: 1;
    min-width: 0;
  }

  .neofetch__user {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .neofetch__separator {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent-dim);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }

  .neofetch__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .neofetch__row {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
  }

  .neofetch__key {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
    min-width: 6rem;
  }

  .neofetch__value {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
    margin: 0;
  }

  .neofetch__palette {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .neofetch__color {
    width: var(--space-6);
    height: var(--space-6);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    display: inline-block;
  }

  .neofetch__bio {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-top: var(--space-8);
    max-width: 42rem;
  }

  @media (max-width: 768px) {
    .neofetch {
      padding: var(--space-10) var(--space-4) var(--space-8);
    }

    .neofetch__card {
      padding: var(--space-5);
    }

    .neofetch__layout {
      flex-direction: column;
      gap: var(--space-5);
    }

    .neofetch__ascii {
      font-size: var(--text-base);
      text-align: center;
    }

    .neofetch__key {
      min-width: 5.5rem;
    }

    .neofetch__color {
      width: var(--space-5);
      height: var(--space-5);
    }
  }
</style>
