---
import Base from '../layouts/Base.astro';
import Preloader from '../components/Preloader.astro';
import HeroScene from '../components/3d/HeroScene.jsx';
import StaticTerminal from '../components/StaticTerminal.astro';
import { t, useTranslatedPath } from '../i18n/utils';

const lang = 'pl';
const translatePath = useTranslatedPath(lang);
---

<Base
  title="Wojtek Koperski — Portfolio"
  description="Uczeń technikum pasjonujący się tworzeniem oprogramowania"
  lang={lang}
>
  <Preloader lang={lang} />

  <!-- Hero Section -->
  <section class="hero">
    <div id="hero-3d" class="hero__canvas">
    <HeroScene client:idle />
  </div>
    <div class="hero__overlay">
      <p class="hero__prompt terminal-text">{t('home.hero.greeting', lang)}</p>
      <h1 class="hero__name terminal-text terminal-glow">{t('home.hero.name', lang)}</h1>
      <span class="hero__cursor cursor-blink terminal-text">_</span>
    </div>
    <div class="hero__static-terminal">
      <StaticTerminal prompt={t('home.hero.greeting', lang)} name={t('home.hero.name', lang)} />
    </div>
  </section>

  <!-- Intro Section -->
  <section class="intro">
    <p class="intro__text">{t('home.intro', lang)}</p>
    <a href={translatePath('/projects')} class="intro__cta terminal-border terminal-text">
      {t('home.cta', lang)}
    </a>
  </section>
</Base>

<style>
  /* Hero Section */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

.hero__canvas {
  position: absolute;
  inset: 0;
  z-index: var(--z-3d-canvas);
}

@media (max-width: 768px) {
  .hero__canvas {
    display: none;
  }
}

.hero__static-terminal {
  display: none; /* Hidden by default (desktop) */
}

@media (max-width: 768px) {
  .hero__static-terminal {
    display: block;
    position: relative;
    z-index: calc(var(--z-3d-canvas) + 1);
    margin-bottom: var(--space-6);
  }
}

  .hero__overlay {
    position: relative;
    z-index: calc(var(--z-3d-canvas) + 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
    padding: var(--space-4);
  }

  .hero__prompt {
    font-size: var(--text-sm);
    opacity: 0.7;
  }

  .hero__name {
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
  }

  .hero__cursor {
    font-size: var(--text-2xl);
    line-height: 1;
  }

  @media (min-width: 768px) {
    .hero__name {
      font-size: var(--text-4xl);
    }

    .hero__prompt {
      font-size: var(--text-base);
    }
  }

  @media (min-width: 1024px) {
    .hero__name {
      font-size: 4rem;
    }
  }

  /* Intro Section */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-16) var(--space-4) var(--space-24);
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }

  .intro__text {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .intro__cta {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    font-size: var(--text-sm);
    transition: box-shadow 0.3s ease, background-color 0.3s ease;
  }

  .intro__cta:hover {
    box-shadow: var(--shadow-glow);
    background-color: rgba(74, 246, 38, 0.05);
  }

  .intro__cta:focus-visible {
    outline: 2px solid var(--color-terminal-green);
    outline-offset: 2px;
  }
</style>
