---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CategoryHeader from '../../components/CategoryHeader.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/utils';
import { categories } from '../../i18n/categories';

const lang = 'en';
const allProjects = await getCollection('projects');

const projectsByCategory = categories
  .map((cat) => ({
    ...cat,
    displayName: cat.name.en,
    projects: allProjects
      .filter((p) => p.data.category === cat.slug)
      .sort((a, b) => a.data.title.localeCompare(b.data.title)),
  }))
  .filter((cat) => cat.projects.length > 0);
---

<Base title={t('projects.title', lang)} lang={lang} description="All projects by Wojciech Koperski — CLI tools, web apps, ML models and more.">
  <main class="flex-grow flex flex-col items-center w-full px-margin-mobile md:px-gutter py-section-gap max-w-container-max mx-auto space-y-section-gap pt-32">
    <!-- Hero Section -->
    <section class="w-full text-left">
      <h1 class="font-headline-xl text-headline-xl text-on-surface mb-6">Engineering <span class="text-primary">Directory</span></h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl">
        A comprehensive archive of {allProjects.length} projects spanning systems programming, machine learning, and full-stack development.
        This directory reflects a commitment to exploring varied architectures and solving technical challenges across multiple domains.
      </p>
    </section>

    <!-- Projects Grid -->
    <div class="w-full space-y-24">
      {projectsByCategory.map((cat) => (
        <CategoryHeader emoji={cat.emoji} name={cat.displayName} count={cat.projects.length}>
          {cat.projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              categoryEmoji={project.data.categoryEmoji}
              description={project.data.description.en}
              techStack={project.data.techStack}
              githubUrl={project.data.githubUrl}
              demoUrl={project.data.demoUrl}
              screenshot={project.data.screenshot}
              year={project.data.year}
              featured={project.data.featured}
              slug={project.id}
              previewData={project.data.previewData}
              lang="en"
            />
          ))}
        </CategoryHeader>
      ))}
    </div>
  </main>
</Base>
