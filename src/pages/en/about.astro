---
import Base from '../../layouts/Base.astro';
import { t, useTranslatedPath } from '../../i18n/utils';

const lang = 'en';
const pageTitle = t('about.title', lang);
---

<Base title={pageTitle} lang={lang} description="Learn more about me, my experience as a Software Engineer, and the technologies I use to build software.">
  <section class="max-w-container-max mx-auto px-gutter pt-32 pb-section-gap">
    <!-- Header Section -->
    <header class="mb-20">
      <div class="flex items-center space-x-4 mb-4">
        <span class="text-primary font-code-sm text-code-sm">~/about</span>
        <div class="h-px bg-outline-variant flex-grow"></div>
      </div>
      <h1 class="font-headline-xl text-headline-xl text-inverse-surface mb-6">System Identity</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">
        Initializing biographical profile... Unpacking details on Wojciech.
      </p>
    </header>

    <!-- Bento Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <!-- Bio Column (Left) -->
      <div class="md:col-span-8 flex flex-col gap-8">

        <!-- Whoami Terminal Card -->
        <div class="bg-surface-elevated border border-outline-variant rounded-lg overflow-hidden relative shadow-lg">
          <!-- Terminal Header -->
          <div class="bg-terminal-header px-4 py-2 flex items-center border-b border-outline-variant">
            <div class="flex space-x-2">
              <div class="w-3 h-3 rounded-full bg-error"></div>
              <div class="w-3 h-3 rounded-full bg-tertiary"></div>
              <div class="w-3 h-3 rounded-full bg-primary"></div>
            </div>
            <span class="ml-4 font-code-sm text-code-sm text-on-surface-variant">wojciech@dev-core: ~</span>
          </div>

          <!-- Terminal Content -->
          <div class="p-6 font-code-sm text-code-sm text-inverse-surface">
            <div class="mb-4">
              <span class="text-primary">$</span> <span class="text-secondary">whoami</span>
            </div>
            <div class="text-on-surface-variant space-y-4 font-body-md text-body-md">
              <p class="text-primary font-bold">Wojciech Koperski</p>
              <p>Hello, I'm a developer who has been coding for over three years. I build everything from CLI tools to web applications and ML models.</p>
              <p>I love the terminal, clean architecture, and drinking coffee while debugging Rust at 2 AM. I am constantly looking for optimal solutions, focusing on performance and reliability.</p>
            </div>
            <div class="mt-4 flex items-center">
              <span class="text-primary">$</span> <span class="blinking-cursor ml-2"></span>
            </div>
          </div>
        </div>

        <!-- Expertise Section -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          <div class="border border-outline-variant bg-surface-elevated rounded-lg p-6 hover:border-primary/50 transition-colors group">
            <div class="absolute inset-0 bg-glow-emerald opacity-0 group-hover:opacity-10 transition-opacity pointer-events-none rounded-lg"></div>
            <div class="relative z-10">
              <div class="flex items-center space-x-3 mb-4">
                <span class="material-symbols-outlined text-primary text-3xl">architecture</span>
                <h3 class="font-headline-md text-headline-md text-inverse-surface">Architecture</h3>
              </div>
              <p class="font-body-md text-body-md text-on-surface-variant">
                Designing scalable systems, focusing on clean code and performant design patterns.
              </p>
            </div>
          </div>
          <div class="border border-outline-variant bg-surface-elevated rounded-lg p-6 hover:border-primary/50 transition-colors group">
             <div class="absolute inset-0 bg-glow-emerald opacity-0 group-hover:opacity-10 transition-opacity pointer-events-none rounded-lg"></div>
             <div class="relative z-10">
                <div class="flex items-center space-x-3 mb-4">
                  <span class="material-symbols-outlined text-primary text-3xl">code_blocks</span>
                  <h3 class="font-headline-md text-headline-md text-inverse-surface">Full Stack</h3>
                </div>
                <p class="font-body-md text-body-md text-on-surface-variant">
                  Deep expertise in creating modern frontends (React) and stable backends (Rust, Node, Python).
                </p>
            </div>
          </div>
        </div>

      </div>

      <!-- Profile Sidebar (Right) -->
      <div class="md:col-span-4 flex flex-col gap-8">
        <!-- Profile Image Card -->
        <div class="border border-outline-variant bg-surface-elevated rounded-lg overflow-hidden">
          <div class="h-64 bg-surface-container relative">
            <img alt="Wojciech Koperski - Profile Visual" class="w-full h-full object-cover opacity-80 mix-blend-luminosity hover:mix-blend-normal transition-all duration-500" src="/mockups/profile-visual.png" />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-elevated to-transparent"></div>
          </div>
          <div class="p-6 border-t border-outline-variant relative">
            <!-- CLI Style Input decorative -->
            <div class="absolute -top-3 left-6 bg-surface-elevated px-2 font-code-sm text-code-sm text-primary border border-outline-variant rounded">
              sys.info()
            </div>
            <ul class="space-y-3 font-code-sm text-code-sm mt-4">
              <li class="flex justify-between border-b border-outline-variant/30 pb-2">
                <span class="text-on-surface-variant">OS</span>
                <span class="text-inverse-surface">Linux / Arch</span>
              </li>
              <li class="flex justify-between border-b border-outline-variant/30 pb-2">
                <span class="text-on-surface-variant">Shell</span>
                <span class="text-inverse-surface">ZSH + tmux</span>
              </li>
              <li class="flex justify-between border-b border-outline-variant/30 pb-2">
                <span class="text-on-surface-variant">Editor</span>
                <span class="text-inverse-surface">Neovim</span>
              </li>
              <li class="flex justify-between pb-2">
                <span class="text-on-surface-variant">Status</span>
                <span class="text-primary">Online</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
