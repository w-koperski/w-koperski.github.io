---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import DetailHero from '../../../components/detail/DetailHero.astro';
import PreviewSection from '../../../components/detail/PreviewSection.astro';
import TechStackSection from '../../../components/detail/TechStackSection.astro';
import DescriptionSection from '../../../components/detail/DescriptionSection.astro';
import CodeSnippetsSection from '../../../components/detail/CodeSnippetsSection.astro';
import HighlightsSection from '../../../components/detail/HighlightsSection.astro';
import LinksSection from '../../../components/detail/LinksSection.astro';
import TerminalTyping from '../../../components/previews/TerminalTyping.jsx';
import BrowserScreenshot from '../../../components/previews/BrowserScreenshot.jsx';
import ApiMockPanel from '../../../components/previews/ApiMockPanel.jsx';
import MetricsDashboard from '../../../components/previews/MetricsDashboard.jsx';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map((project) => ({
    params: { slug: project.id },
    props: { project, allProjects },
  }));
}

const { project, allProjects } = Astro.props;
const lang = 'en';

// Previous/next navigation within same category
const categoryProjects = allProjects
  .filter((p: { data: { category: string } }) => p.data.category === project.data.category)
  .sort((a: { data: { title: string } }, b: { data: { title: string } }) =>
    a.data.title.localeCompare(b.data.title),
  );
const currentIdx = categoryProjects.findIndex(
  (p: { id: string }) => p.id === project.id,
);
const prevProject = currentIdx > 0 ? categoryProjects[currentIdx - 1] : null;
const nextProject =
  currentIdx < categoryProjects.length - 1 ? categoryProjects[currentIdx + 1] : null;
---

<Base title={`${project.data.title} — Portfolio`} lang={lang} description={project.data.description.en}>
  <article class="detail">
    <DetailHero
      title={project.data.title}
      category={project.data.category}
      categoryEmoji={project.data.categoryEmoji}
      year={project.data.year}
      description={project.data.description.en}
      lang={lang}
    />

    <PreviewSection label="Preview">
      {project.data.previewData?.type === 'terminal' && (
        <TerminalTyping
          commands={project.data.previewData.commands}
          lang={lang}
          client:visible
          autoplay={true}
        />
      )}
      {project.data.previewData?.type === 'browser' && (
        <BrowserScreenshot
          screenshots={(project.data.previewData as any).screenshots}
          liveUrl={(project.data.previewData as any).liveUrl}
          title={project.data.title}
          client:visible
        />
      )}
      {project.data.previewData?.type === 'api' && (
        <ApiMockPanel
          endpoints={project.data.previewData.endpoints}
          lang={lang}
          client:visible
        />
      )}
      {project.data.previewData?.type === 'metrics' && (
        <MetricsDashboard
          epochs={project.data.previewData.epochs}
          accuracyData={project.data.previewData.accuracyData}
          lossData={project.data.previewData.lossData}
          finalAccuracy={project.data.previewData.finalAccuracy}
          samplePredictions={project.data.previewData.samplePredictions}
          client:visible
        />
      )}
      {!project.data.previewData && project.data.screenshot && (
        <img
          src={project.data.screenshot}
          alt={`${project.data.title} preview`}
          loading="lazy"
          style="max-width: 100%; height: auto;"
        />
      )}
    </PreviewSection>

    <TechStackSection techStack={project.data.techStack} lang={lang} />

    <DescriptionSection
      longDescription={project.data.longDescription}
      shortDescription={project.data.description.en}
      lang={lang}
    />

    <CodeSnippetsSection snippets={project.data.codeSnippets} lang={lang} />

    <HighlightsSection highlights={project.data.highlights} lang={lang} />

    <LinksSection
      githubUrl={project.data.githubUrl}
      demoUrl={project.data.demoUrl}
      lang={lang}
    />

    <!-- Prev/Next navigation -->
    {(prevProject || nextProject) && (
      <nav class="detail-nav">
        {prevProject && (
          <a href={`/en/projects/${prevProject.id}`} class="detail-nav__link detail-nav__link--prev">
            ← {prevProject.data.title}
          </a>
        )}
        {nextProject && (
          <a href={`/en/projects/${nextProject.id}`} class="detail-nav__link detail-nav__link--next">
            {nextProject.data.title} →
          </a>
        )}
      </nav>
    )}
  </article>
</Base>

<style>
  .detail {
  max-width: 56rem;
  margin: 0 auto;
  padding: var(--space-8) var(--space-6);
  overflow-x: hidden;
  }

  .detail-nav {
  display: flex;
  justify-content: space-between;
  padding: var(--space-8) 0;
  border-top: 1px solid var(--color-border);
  margin-top: var(--space-8);
  }

  .detail-nav__link {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--color-terminal-green);
  text-decoration: none;
  opacity: 0.7;
  transition: opacity 0.2s;
  word-break: break-word;
  }

  .detail-nav__link:hover {
  opacity: 1;
  }

  .detail-nav__link--next {
  margin-left: auto;
  }

  @media (max-width: 768px) {
  .detail {
    padding: var(--space-6) var(--space-4);
  }

  .detail img {
    max-width: 100%;
    height: auto;
  }
  }
</style>
