---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { t } from '../../../i18n/utils';
import PreviewSection from '../../../components/detail/PreviewSection.astro';
import BrowserScreenshot from '../../../components/previews/BrowserScreenshot.jsx';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map((project) => ({
    params: { slug: project.id },
    props: { project, allProjects },
  }));
}

const { project, allProjects } = Astro.props;
const lang = 'en';

const categoryProjects = allProjects
  .filter((p: { data: { category: string } }) => p.data.category === project.data.category)
  .sort((a: { data: { title: string } }, b: { data: { title: string } }) =>
    a.data.title.localeCompare(b.data.title),
  );
const currentIdx = categoryProjects.findIndex(
  (p: { id: string }) => p.id === project.id,
);
const prevProject = currentIdx > 0 ? categoryProjects[currentIdx - 1] : null;
const nextProject =
  currentIdx < categoryProjects.length - 1 ? categoryProjects[currentIdx + 1] : null;
const pd = project.data.previewData;
---

<Base title={`${project.data.title} — Portfolio`} lang={lang} description={project.data.description.en} image={project.data.screenshot} article={true}>
  <main class="flex-grow pt-32 pb-section-gap px-gutter w-full">
    <!-- Header Section -->
    <header class="max-w-container-max mx-auto mb-16 relative">
      <a href="/en/projects" class="inline-flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors font-label-caps text-label-caps mb-8 group">
        <span class="material-symbols-outlined text-[16px] group-hover:-translate-x-1 transition-transform">arrow_back</span>
        Back to Directory
      </a>

      <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-b border-outline-variant/30 pb-8 relative z-10">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="text-3xl">{project.data.categoryEmoji}</span>
            <span class="font-label-caps text-label-caps border border-outline-variant px-3 py-1 rounded text-on-surface-variant">{project.data.category}</span>
          </div>
          <h1 class="font-headline-xl text-headline-xl text-on-surface mb-4">{project.data.title}</h1>
          <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">{project.data.description.en}</p>
        </div>

        <div class="flex flex-wrap gap-4">
          <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="bg-surface-elevated border border-outline-variant text-on-surface px-6 py-3 rounded hover:bg-surface-container-high transition-colors font-label-caps text-label-caps flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">code</span>
            View Source
          </a>
          {project.data.demoUrl && (
            <a href={project.data.demoUrl} target="_blank" rel="noopener noreferrer" class="bg-primary text-on-primary px-6 py-3 rounded font-label-caps text-label-caps flex items-center gap-2 hover:bg-primary-fixed hover:shadow-[0_0_15px_rgba(16,185,129,0.3)] transition-all">
              <span class="material-symbols-outlined text-[18px]">play_arrow</span>
              Live Demo
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Content Sections -->
    <div class="max-w-container-max mx-auto space-y-24">

      <!-- Visual Preview -->
      {project.data.screenshot && (
        <section class="max-w-5xl mb-16">
          <BrowserScreenshot screenshots={project.data.screenshot ? ([project.data.screenshot] as any) : []} liveUrl={project.data.demoUrl} client:visible />
        </section>
      )}

      <!-- Full Description -->
      <section class="max-w-3xl">
        <h2 class="font-headline-md text-headline-md text-on-surface mb-6 border-b border-outline-variant/20 pb-2">Overview</h2>
        <div class="font-body-md text-body-md text-on-surface-variant space-y-4">
          {project.data.longDescription ? (
             <p>{project.data.longDescription.en}</p>
          ) : (
             <p>{project.data.description.en}</p>
          )}
        </div>
      </section>

      <!-- Tech Stack -->
      <section>
        <h2 class="font-headline-md text-headline-md text-on-surface mb-6 border-b border-outline-variant/20 pb-2">Tech Stack</h2>
        <div class="flex flex-wrap gap-3">
          {project.data.techStack.map((tech) => (
            <span class="bg-surface-container border border-outline-variant px-4 py-2 rounded text-primary font-code-sm text-code-sm">
              {tech}
            </span>
          ))}
        </div>
      </section>

      <!-- Highlights -->
      {project.data.highlights && project.data.highlights.en && project.data.highlights.en.length > 0 && (
        <section class="max-w-4xl">
          <h2 class="font-headline-md text-headline-md text-on-surface mb-6 border-b border-outline-variant/20 pb-2">Key Highlights</h2>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {project.data.highlights.en.map((highlight) => (
              <li class="flex items-start gap-3 bg-surface-container-low p-4 rounded border border-outline-variant/20">
                <span class="material-symbols-outlined text-primary text-[20px] mt-0.5">check_circle</span>
                <span class="font-body-md text-body-md text-on-surface-variant">{highlight}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      <!-- Code Snippets -->
      {project.data.codeSnippets && project.data.codeSnippets.length > 0 && (
        <section class="max-w-5xl">
          <h2 class="font-headline-md text-headline-md text-on-surface mb-6 border-b border-outline-variant/20 pb-2">Architecture / Code</h2>
          <div class="grid grid-cols-1 gap-8">
            {project.data.codeSnippets.map((snippet) => (
              <div class="bg-surface-elevated border border-outline-variant rounded-xl overflow-hidden">
                <div class="bg-terminal-header px-4 py-3 border-b border-outline-variant/50 flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="w-3 h-3 rounded-full bg-error/50"></div>
                    <div class="w-3 h-3 rounded-full bg-tertiary-fixed-dim/50"></div>
                    <div class="w-3 h-3 rounded-full bg-primary/50"></div>
                  </div>
                  <span class="font-code-sm text-code-sm text-on-surface-variant">{snippet.title} ({snippet.language})</span>
                </div>
                <div class="p-6 overflow-x-auto bg-[#0a0f18]">
                  <pre class="font-code-sm text-code-sm text-primary-fixed leading-relaxed"><code>{snippet.code}</code></pre>
                </div>
                {(snippet as any).description && (
                  <div class="bg-surface-container-low p-4 border-t border-outline-variant/20">
                     <p class="font-body-md text-sm text-on-surface-variant">{(snippet as any).description.en}</p>
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- Pagination -->
    {(prevProject || nextProject) && (
      <nav class="max-w-container-max mx-auto mt-32 pt-8 border-t border-outline-variant/30 flex justify-between">
        {prevProject ? (
          <a href={`/en/projects/${prevProject.id}`} class="flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors font-label-caps">
            <span class="material-symbols-outlined">chevron_left</span> Previous: {prevProject.data.title}
          </a>
        ) : <div></div>}
        {nextProject && (
          <a href={`/en/projects/${nextProject.id}`} class="flex items-center gap-2 text-on-surface-variant hover:text-primary transition-colors font-label-caps">
            Next: {nextProject.data.title} <span class="material-symbols-outlined">chevron_right</span>
          </a>
        )}
      </nav>
    )}
  </main>
</Base>
