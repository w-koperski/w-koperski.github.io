---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/utils';

const lang = 'pl';
const pageTitle = t('contact.title', lang);

// Configuration for social links - easily changeable
const config = {
  email: "koperski.wojciech.06@gmail.com",
  githubUrl: "https://github.com/w-koperski",
  linkedinUrl: "#",
  stackoverflowUrl: "#"
};
---

<Base title={pageTitle} lang={lang} description="Skontaktuj się ze mną. Znajdziesz tu mój adres email oraz link do profilu GitHub, gdzie publikuję swoje projekty open-source.">
  <div class="w-full max-w-container-max mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <!-- Hero Section -->
    <section class="mb-16">
      <div class="flex items-center gap-4 mb-4">
        <div class="flex items-center gap-2 px-3 py-1 bg-surface-container rounded-full border border-outline-variant">
          <span class="w-2 h-2 rounded-full bg-primary shadow-[0_0_8px_rgba(78,222,163,0.8)]"></span>
          <span class="font-label-caps text-label-caps text-primary">{t('contact.status', lang)}</span>
        </div>
      </div>
      <h1 class="font-headline-lg-mobile md:font-headline-xl text-headline-lg-mobile md:text-headline-xl text-on-background flex flex-wrap items-end gap-1">
        {t('contact.headline', lang)}<span class="blinking-cursor text-primary ml-1"></span>
      </h1>
      <p class="font-body-md md:font-body-lg text-body-md md:text-body-lg text-on-surface-variant mt-4 max-w-2xl">
        {t('contact.description', lang)}
      </p>
    </section>

    <!-- Terminal & Grid Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Terminal Contact Card -->
      <div class="lg:col-span-7 bg-surface-elevated rounded-lg border border-outline-variant overflow-hidden shadow-sm shadow-glow-emerald">
        <!-- Terminal Header -->
        <div class="bg-terminal-header border-b border-outline-variant px-4 py-3 flex items-center gap-4">
          <div class="flex gap-2">
            <div class="w-3 h-3 rounded-full bg-error"></div>
            <div class="w-3 h-3 rounded-full bg-tertiary"></div>
            <div class="w-3 h-3 rounded-full bg-primary"></div>
          </div>
          <div class="font-code-sm text-code-sm text-secondary-fixed-dim">
            wk@portfolio:~$ cat contact.txt
          </div>
        </div>
        <!-- Terminal Body -->
        <div class="p-4 sm:p-6 font-code-sm text-code-sm text-primary-fixed-dim space-y-4 overflow-x-auto">
          <div class="flex">
            <span class="text-tertiary mr-4 select-none">01</span>
            <span class="text-on-surface whitespace-nowrap">const contact = {'{'}</span>
          </div>
          <div class="flex">
            <span class="text-tertiary mr-4 select-none">02</span>
            <span class="text-on-surface ml-4 whitespace-nowrap">email: <a class="text-primary hover:underline" href={`mailto:${config.email}`}>"{config.email}"</a>,</span>
          </div>
          <div class="flex">
            <span class="text-tertiary mr-4 select-none">03</span>
            <span class="text-on-surface ml-4 whitespace-nowrap">github: <a class="text-primary hover:underline" href={config.githubUrl} target="_blank" rel="noopener noreferrer">"github.com/w-koperski"</a>,</span>
          </div>
          <div class="flex">
            <span class="text-tertiary mr-4 select-none">04</span>
            <span class="text-on-surface ml-4 whitespace-nowrap">{t('contact.availability.label', lang)}: <span class="text-secondary-fixed">{t('contact.availability.value', lang)}</span></span>
          </div>
          <div class="flex">
            <span class="text-tertiary mr-4 select-none">05</span>
            <span class="text-on-surface whitespace-nowrap">{'}'};</span>
          </div>
          <div class="flex pt-4">
            <span class="text-tertiary mr-4 select-none">06</span>
            <span class="text-on-surface whitespace-nowrap">&gt; <span class="blinking-cursor ml-1"></span></span>
          </div>
        </div>
      </div>

      <!-- Social Grid -->
      <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4">
        <!-- Source Code -->
        <a class="group bg-surface-container border border-outline-variant rounded-lg p-5 flex items-center justify-between hover:bg-surface-container-highest hover:border-primary transition-all duration-300 hover:shadow-[0_0_15px_rgba(78,222,163,0.1)]" href={config.githubUrl} target="_blank" rel="noopener noreferrer">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded bg-surface-container-highest flex items-center justify-center border border-outline-variant group-hover:border-primary transition-colors shrink-0">
              <span class="material-symbols-outlined text-on-surface group-hover:text-primary transition-colors">code</span>
            </div>
            <div>
              <h3 class="font-headline-md text-body-md font-bold text-on-surface">{t('contact.social.source.title', lang)}</h3>
              <p class="font-label-caps text-label-caps text-on-surface-variant">{t('contact.social.source.desc', lang)}</p>
            </div>
          </div>
          <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors shrink-0">arrow_forward</span>
        </a>

        <!-- Professional Network -->
        <a class="group bg-surface-container border border-outline-variant rounded-lg p-5 flex items-center justify-between hover:bg-surface-container-highest hover:border-primary transition-all duration-300 hover:shadow-[0_0_15px_rgba(78,222,163,0.1)]" href={config.linkedinUrl} target="_blank" rel="noopener noreferrer">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded bg-surface-container-highest flex items-center justify-center border border-outline-variant group-hover:border-primary transition-colors shrink-0">
              <span class="material-symbols-outlined text-on-surface group-hover:text-primary transition-colors">group</span>
            </div>
            <div>
              <h3 class="font-headline-md text-body-md font-bold text-on-surface">{t('contact.social.network.title', lang)}</h3>
              <p class="font-label-caps text-label-caps text-on-surface-variant">{t('contact.social.network.desc', lang)}</p>
            </div>
          </div>
          <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors shrink-0">arrow_forward</span>
        </a>

        <!-- Developer Profile -->
        <a class="group bg-surface-container border border-outline-variant rounded-lg p-5 flex items-center justify-between hover:bg-surface-container-highest hover:border-primary transition-all duration-300 hover:shadow-[0_0_15px_rgba(78,222,163,0.1)]" href={config.stackoverflowUrl} target="_blank" rel="noopener noreferrer">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded bg-surface-container-highest flex items-center justify-center border border-outline-variant group-hover:border-primary transition-colors shrink-0">
              <span class="material-symbols-outlined text-on-surface group-hover:text-primary transition-colors">terminal</span>
            </div>
            <div>
              <h3 class="font-headline-md text-body-md font-bold text-on-surface">{t('contact.social.profile.title', lang)}</h3>
              <p class="font-label-caps text-label-caps text-on-surface-variant">{t('contact.social.profile.desc', lang)}</p>
            </div>
          </div>
          <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors shrink-0">arrow_forward</span>
        </a>
      </div>
    </div>
  </div>
</Base>


