{
  "title": "E-commerce Backend",
  "category": "laravel-api",
  "categoryEmoji": "🔷",
  "description": {
    "pl": "REST API sklepu internetowego napisane w Laravel 10. Zarządzanie produktami i zamówieniami ze statusem zamówień.",
    "en": "REST API for an e-commerce store written in Laravel 10. Manage products and orders with order status management."
  },
  "techStack": [
    "Laravel",
    "PHP"
  ],
  "githubUrl": "https://github.com/w-koperski/ecommerce-backend",
  "year": 2024,
  "featured": false,
  "screenshot": "/mockups/e-commerce-backend.svg",
  "previewData": {
    "type": "api",
    "endpoints": [
      {
        "method": "GET",
        "path": "/api/products",
        "description": {
          "pl": "Lista produktów",
          "en": "List products"
        },
        "requestExample": "{\"page\":1,\"limit\":10}",
        "responseExample": "{\"data\":[{\"id\":1,\"name\":\"Product A\",\"price\":29.99,\"stock\":50}],\"total\":150}"
      },
      {
        "method": "POST",
        "path": "/api/orders",
        "description": {
          "pl": "Utwórz zamówienie",
          "en": "Create order"
        },
        "requestExample": "{\"items\":[{\"product_id\":1,\"quantity\":2}]}",
        "responseExample": "{\"order_id\":\"ORD-2024-001\",\"total\":59.98,\"status\":\"pending\"}"
      },
      {
        "method": "GET",
        "path": "/api/orders/{id}",
        "description": {
          "pl": "Szczegóły zamówienia",
          "en": "Order details"
        },
        "requestExample": "{}",
        "responseExample": "{\"id\":\"ORD-2024-001\",\"status\":\"shipped\",\"items\":[{\"name\":\"Product A\",\"qty\":2}]}"
      }
    ]
  }
}
