---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/terminal.css';
import '../styles/animations.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  lang?: 'pl' | 'en';
  image?: string;
  article?: boolean;
}

const { title, description = '', lang = 'pl', image = '/screenshots/github-stats-1280.webp', article = false } = Astro.props;

// Generate hreflang paths
const pathname = Astro.url.pathname;
const defaultPath = pathname.replace(/^\/en/, '') || '/';
const plPath = defaultPath;
const enPath = defaultPath === '/' ? '/en' : `/en${defaultPath}`;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://w-koperski.github.io';
---

<!DOCTYPE html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@600;700;800&family=Inter:wght@400&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- i18n hreflang tags -->
    <link rel="alternate" hreflang="pl" href={`${siteUrl}${plPath}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${plPath}`} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Wojciech Koperski — Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || 'Developer pasjonujący się tworzeniem oprogramowania'} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'pl' ? 'en_US' : 'pl_PL'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || 'Portfolio Wojciecha Koperskiego'} />
    <meta name="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Canonical + Favicon -->
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://personal.koperski.tech; connect-src 'self' https://personal.koperski.tech;" />
    <ViewTransitions />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Wojciech Koperski",
      "jobTitle": "Software Engineer",
      "url": siteUrl,
      "sameAs": [
        "https://github.com/w-koperski"
      ]
    })} />
  </head>
  <body class="bg-background text-on-background font-body-md text-body-md grid-bg min-h-screen flex flex-col antialiased">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Nav lang={lang} currentPath={Astro.url.pathname} />
    <main id="main-content" class="flex-grow pt-16">
      <slot />
    </main>
    <Footer lang={lang} />
<script>
  import { initAnimations } from '../scripts/gsap-animations';

  // Run on initial page load and after each Astro View Transition
  initAnimations();
  document.addEventListener('astro:page-load', initAnimations);
</script>
  </body>
</html>
